# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# New key naming (sb_publishable_...) — preferred going forward.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy alias. Set to the SAME value as PUBLISHABLE_KEY so existing
# utils/supabase/server.ts keeps working without edits.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...   # server-only, never expose

# Direct Postgres URL for `supabase db push` and psql. Pulled from the
# Supabase dashboard → Project Settings → Database → Connection string.
# If on an IPv4-only network, use the Session Pooler URL instead.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres

# Stripe — core
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe — product prices (create in dashboard, paste ids here)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_AGENCY=price_...
# Optional annual variants (fall back to monthly if unset)
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_GROWTH_ANNUAL=price_...
STRIPE_PRICE_AGENCY_ANNUAL=price_...

# Email verification
NEVERBOUNCE_API_KEY=...
ZEROBOUNCE_API_KEY=...
HUNTER_API_KEY=...
SNOV_CLIENT_ID=...
SNOV_CLIENT_SECRET=...

# Data sources
APOLLO_API_KEY=...
COMMONROOM_API_KEY=...
SCRAPINGBEE_API_KEY=...
BRIGHTDATA_API_KEY=...

# Google Places API (New) — used by /api/places-salons. Enable the
# "Places API (New)" product on the GCP project, not just the legacy one.
GOOGLE_PLACES_KEY=AIza...
# /api/scrape-osm uses OpenStreetMap Overpass — no key required.

# smartly.io
SMARTLY_API_TOKEN=...
SMARTLY_ACCOUNT_ID=...
SMARTLY_API_BASE=https://api.smartly.io/api/v3
SMARTLY_AUDIENCE_PATH=/custom_audiences

# Klaviyo (first-party suppression sync)
KLAVIYO_API_KEY=pk_...

# Shopify (no API key needed — CSV upload. Add these only if we move to direct API sync)
# SHOPIFY_SHOP=chella.myshopify.com
# SHOPIFY_ADMIN_TOKEN=shpat_...

# Server-to-server ingest secret (shared with cron + import jobs)
INGEST_SECRET=replace-with-long-random-string

# App
NEXT_PUBLIC_APP_URL=https://oneclickitleads.com
